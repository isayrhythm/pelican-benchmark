{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pelican-benchmark-reactions",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "REACTIONS", "class_name": "ReactionStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReactionStore"]}],
  "ratelimits": [
    {"name": "VISITOR_LIMIT", "namespace_id": "93026001", "simple": {"limit": 60, "period": 60}},
    {"name": "IP_LIMIT", "namespace_id": "93026002", "simple": {"limit": 300, "period": 60}}
  ]
}
